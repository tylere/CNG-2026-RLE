{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "baseUrl": "."
  },
  "include": [
    "slides.md",
    "components/**/*.ts",
    "components/**/*.vue",
    "composables/**/*.ts",
    "layouts/**/*.vue",
    "test/**/*.ts"
  ]
}
